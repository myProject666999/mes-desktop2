<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mes.controller.MaterialProductController"
            stylesheets="/css/style.css"
            styleClass="content-area">

    <left>
        <VBox spacing="5" prefWidth="200" style="-fx-background-color: #252526; -fx-padding: 10;">
            <Label text="物料产品分类" style="-fx-text-fill: #cccccc; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 5;"/>
            <TreeView fx:id="categoryTree" style="-fx-background-color: #252526;" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label styleClass="content-header" text="物料产品管理"/>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="search-box">
                <Label text="物料编码:"/>
                <TextField fx:id="codeSearchField" promptText="请输入物料编码" prefWidth="120"/>
                
                <Label text="物料名称:"/>
                <TextField fx:id="nameSearchField" promptText="请输入物料名称" prefWidth="120"/>
                
                <Label text="是否启用:"/>
                <ComboBox fx:id="enabledSearchCombo" prefWidth="100"/>
                
                <Button styleClass="primary-button" text="查询" onAction="#handleSearch"/>
                <Button styleClass="default-button" text="重置" onAction="#handleReset"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="addButton" styleClass="primary-button" text="新增" onAction="#showAddDialog"/>
                <Button fx:id="editButton" styleClass="default-button" text="修改" onAction="#handleBatchEdit"/>
                <Button fx:id="deleteButton" styleClass="danger-button" text="删除" onAction="#handleBatchDelete"/>
            </HBox>

            <TableView fx:id="productTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="codeColumn" text="物料编码" prefWidth="100"/>
                    <TableColumn fx:id="nameColumn" text="物料名称" prefWidth="150"/>
                    <TableColumn fx:id="categoryColumn" text="分类" prefWidth="100"/>
                    <TableColumn fx:id="specificationColumn" text="规格" prefWidth="100"/>
                    <TableColumn fx:id="unitColumn" text="单位" prefWidth="60"/>
                    <TableColumn fx:id="typeColumn" text="类型" prefWidth="80"/>
                    <TableColumn fx:id="enabledColumn" text="是否启用" prefWidth="80"/>
                    <TableColumn fx:id="actionColumn" text="操作" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
